{
  "name": "routewise-backend",
  "version": "1.0.0",
  "description": "RouteWise REST API — layered architecture with PostgreSQL",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "db:migrate": "psql $DATABASE_URL -f src/infrastructure/database/migrations/001_create_routes_table.sql && psql $DATABASE_URL -f src/infrastructure/database/migrations/002_create_user_tables.sql",
    "db:seed": "psql $DATABASE_URL -f src/infrastructure/database/seeds/routes_seed.sql"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
